# Rust build artifacts
/target/

# SQLite database files
*.db
*.db-shm
*.db-wal

# ZK circom binary (auto-downloaded per platform). The linux-amd64 build is
# committed as zk/bin/circom; per-platform downloads (macOS/Windows) land at
# distinct tagged paths and must not be committed.
zk/bin/circom.exe
zk/bin/circom-*

# ZK build artifacts (generated by circom/snarkjs)
zk/build/*
!zk/build/.gitkeep
zk/keys/*
!zk/keys/.gitkeep

# Piper TTS binary and voice model files (downloaded at deploy time).
# `.gitkeep` stubs are committed so `crates/annex-desktop/tauri.conf.json`'s
# `bundle.resources` validation finds the directories on a fresh clone —
# the actual binary/model files still live outside git.
assets/piper/*
!assets/piper/.gitkeep
assets/voices/*
!assets/voices/.gitkeep
assets/models/
assets/whisper/

# Tauri build output (copied from client/dist by build-desktop.js)
crates/annex-desktop/dist/

# Node modules (ZK toolchain)
node_modules/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Playwright E2E test artifacts
client/e2e-results/
client/e2e-report/

# Puppeteer E2E screenshots (regenerated each run)
client/e2e-puppeteer/screenshots/

# Server signing keys (auto-generated)
signing.key

# Client ZK artifacts (copied from zk/ by prepare-zk-dev.js)
client/public/zk/

# Environment files
.env
.env.*

# OS files
Thumbs.db
client/e2e-puppeteer/screenshots-voice/
client/e2e-puppeteer/screenshots-edge/

# UI audit: per-run warm auth state (binds to a per-run Merkle root, never committed)
client/e2e/audit/.auth/
# UI audit: failure evidence, regenerated each run
client/e2e/audit/diagnostics/
# UI audit: captures of surfaces that are audited but never pixel-diffed
# (reportOnly). Not baselines — nothing compares against them, so tracking
# them would just dirty the tree after every green run.
client/e2e/audit/captures/
# UI audit: the raw per-run ledger (append order, cleared at the start of each
# run) and the rendered contact sheet. The sorted ledger,
# docs/ui-audit/findings.json, IS tracked — it is the reviewable record of what
# the audit currently finds, and it diffs cleanly.
docs/ui-audit/findings.jsonl
docs/ui-audit/index.html

# The server's runtime data directory: `ANNEX_UPLOAD_DIR` defaults to
# `data/uploads`, so every real upload lands here — including the ones the UI
# audit's `message-image-lightbox` surface makes, four per run.
#
# It was never ignored, and 96 of those PNGs were committed across six
# commits before anyone noticed, because the surface was changed to upload for
# real (so the URL in the message it leaves behind actually resolves) and the
# commits that followed used `git add -A`. Nothing here is source: it is one
# server instance's stored files.
data/


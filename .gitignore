# Rust build artifacts
/target/

# SQLite database files
*.db
*.db-shm
*.db-wal

# ZK circom binary (auto-downloaded per platform)
zk/bin/circom.exe

# ZK build artifacts (generated by circom/snarkjs)
zk/build/*
!zk/build/.gitkeep
zk/keys/*
!zk/keys/.gitkeep

# Piper TTS binary and voice model files (downloaded at deploy time)
assets/piper/
assets/voices/
assets/models/
assets/whisper/

# Tauri build output (copied from client/dist by build-desktop.js)
crates/annex-desktop/dist/

# Node modules (ZK toolchain)
node_modules/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Playwright E2E test artifacts
client/e2e-results/
client/e2e-report/

# Server signing keys (auto-generated)
signing.key

# Test-leakage artifact: `annex_server::config::tests::defaults_are_loaded_when_file_missing`
# passes a relative path to load_config(), which then writes default
# config to that path on disk in the crate root. The path name is
# load-bearing for the test (it's the very fixture string), so we
# gitignore the leftover instead of relocating the test.
crates/annex-server/this-file-does-not-exist.toml

# Client ZK artifacts (copied from zk/ by prepare-zk-dev.js)
client/public/zk/

# Environment files
.env
.env.*

# OS files
Thumbs.db

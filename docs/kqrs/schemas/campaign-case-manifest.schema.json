{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KQRS preregistered adversarial case population",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "kqrs.campaign_cases.v2"
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "implementation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "contract_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "prepared_at",
    "configuration_digest",
    "case_ids",
    "implementation_digest",
    "campaign_contract_sha256",
    "case_contracts"
  ],
  "additionalProperties": false
}

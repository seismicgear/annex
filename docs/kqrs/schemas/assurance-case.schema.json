{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KQRS assurance case",
  "description": "Completed record shape. Use tools/validate.py for exact artifact hashes, reference resolution, source blob identities, scope/build/configuration binding, evidence-class coverage and qualification consistency.",
  "type": "object",
  "properties": {
    "template": {
      "const": false
    },
    "record_type": {
      "const": "kqrs.assurance_case"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "standard_version": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_revision": {
      "type": "string",
      "minLength": 1
    },
    "implementation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementer_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "open",
        "qualified",
        "withdrawn",
        "expired"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assessor_id": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "enum": [
        "internal",
        "independent"
      ]
    },
    "argument": {
      "type": "string",
      "minLength": 1
    },
    "scope_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "independence_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "claim_type": {
            "enum": [
              "implementation",
              "tested_behavior",
              "deployed_behavior",
              "independent_assurance"
            ]
          },
          "status": {
            "enum": [
              "open",
              "supported",
              "refuted",
              "withdrawn"
            ]
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^KQRS-[GQPAIV]-[0-9]{2}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "claim_id",
          "statement",
          "required",
          "claim_type",
          "status",
          "control_ids",
          "source_ids",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "supported"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "challenge_id",
          "claim_ids",
          "severity",
          "description",
          "status",
          "resolution_evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "resolution_evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "template",
    "record_type",
    "record_id",
    "standard_version",
    "scope_id",
    "scope_revision",
    "implementation_digest",
    "configuration_digest",
    "implementer_id",
    "created_at",
    "valid_until",
    "record_status",
    "sources",
    "evidence",
    "assessor_id",
    "basis",
    "argument",
    "scope_evidence_ref",
    "claims",
    "challenges"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "source_id",
        "repository",
        "revision",
        "path",
        "blob_sha",
        "artifact"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "command_or_harness": {
          "type": "string",
          "minLength": 1
        },
        "executed_by": {
          "type": "string",
          "minLength": 1
        },
        "harness_source_id": {
          "type": "string",
          "minLength": 1
        },
        "harness_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "run_id",
        "command_or_harness",
        "executed_by",
        "harness_source_id",
        "harness_revision",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source_inspection",
            "test_definition",
            "test_run",
            "adversarial_run",
            "deployment_observation",
            "independent_review",
            "scope_review",
            "release_record"
          ]
        },
        "result": {
          "enum": [
            "observed",
            "passed",
            "failed",
            "inconclusive",
            "not_run"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_revision": {
          "type": "string",
          "minLength": 1
        },
        "implementation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "control_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^KQRS-[GQPAIV]-[0-9]{2}$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1
        },
        "covered_case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "result",
        "scope_id",
        "scope_revision",
        "implementation_digest",
        "configuration_digest",
        "producer_id",
        "method",
        "source_ids",
        "control_ids",
        "observed_at",
        "valid_until",
        "artifact"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "test_definition"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "const": "not_run"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source_inspection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "const": "observed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "test_run",
                  "adversarial_run"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "execution"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deployment_observation"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "deployment_id"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "basis": {
            "const": "independent"
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "required": [
          "independence_evidence_ref"
        ],
        "properties": {
          "independence_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "qualified"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "required"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "supported"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

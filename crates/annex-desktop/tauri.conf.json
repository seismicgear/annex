{
  "productName": "Annex",
  "version": "0.1.3",
  "identifier": "com.annex.desktop",
  "build": {
    "beforeBuildCommand": "node ../scripts/build-desktop.js",
    "beforeDevCommand": "node ../scripts/prepare-zk-dev.js && npm --prefix ../client run dev",
    "frontendDist": "./dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Annex",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "url": "index.html",
        "backgroundColor": "#000000",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https://tauri.localhost; connect-src * ws: wss:; img-src 'self' data: blob: http: https:; media-src 'self' blob: data: mediastream: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "annex"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../THIRD_PARTY_NOTICES.md",
      "../../zk/keys/membership_vkey.json",
      "../../zk/keys/membership_v2_vkey.json",
      "../../zk/keys/channel_eligibility_vkey.json",
      "../../zk/keys/link_pseudonyms_vkey.json",
      "../../zk/keys/federation_attestation_vkey.json",
      "../../assets/piper",
      "../../assets/voices",
      "../../assets/whisper",
      "../../assets/models/ggml-base.en.bin",
      "../../assets/embedding"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/bin/update-desktop-database": "/usr/bin/update-desktop-database",
          "/usr/share/doc/desktop-file-utils/copyright": "/usr/share/doc/desktop-file-utils/copyright"
        }
      },
      "deb": {
        "desktopTemplate": "linux/Annex.desktop",
        "depends": [
          "desktop-file-utils",
          "libwebkit2gtk-4.1-0 (>= 2.40)",
          "libgtk-3-0",
          "libpipewire-0.3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis/hooks.nsi"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}

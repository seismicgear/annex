# Force LF line endings for shell scripts so they work in Docker
*.sh text eol=lf
# Hash-pinned ceremony JSON must retain its exact committed bytes on Windows.
zk/artifacts/**/*.json text eol=lf
# Dependency backports are verified byte-for-byte against upstream archives.
vendor/** -text
scripts/single-instance-regressions/** -text
scripts/updater-archive-regressions/** -text
scripts/security-regressions/** -text
scripts/dtls-regressions/** -text
# The shared Array verifier is hash-pinned across Windows and Unix checkouts.
scripts/vendor/array/** text eol=lf

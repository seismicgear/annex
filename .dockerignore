# Rust build artifacts (can be multiple GB)
target/

# Node modules (rebuilt in Docker)
node_modules/
client/node_modules/
zk/node_modules/

# Git history
.git/
.gitignore

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Local data / runtime
data/
*.db
*.db-journal
*.db-wal

# CI / docs
.github/
*.md
LICENSE*

# Runtime distribution notice is explicitly copied by Dockerfile.
!THIRD_PARTY_NOTICES.md

# Security backports retain exact upstream source and license/provenance files.
!vendor/**
